{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "ignoreCommand": "git log -1 --pretty=%B | grep -qF '[deploy]' && exit 1 || exit 0",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": [
    "dub1"
  ],
  "crons": [
    {
      "path": "/api/cron/due-date-notifications",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 8 * * *"
    }
  ]
}
