{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**"
      ],
      "env": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_URL",
        "PAYSTACK_SECRET_KEY",
        "PAYSTACK_PLAN_MONTHLY_NGN",
        "PAYSTACK_PLAN_ANNUAL_NGN",
        "PAYSTACK_PLAN_MONTHLY_USD",
        "PAYSTACK_PLAN_ANNUAL_USD",
        "ADMIN_EMAILS",
        "DATABASE_URL",
        "NEXT_PUBLIC_POSTHOG_TOKEN",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_FEATURE_WORKSPACE",
        "NEXT_PUBLIC_FEATURE_CHAPPI",
        "NEXT_PUBLIC_FEATURE_CONTENT_CALENDAR",
        "NEXT_PUBLIC_FEATURE_FIRST_WIN",
        "NEXT_PUBLIC_FEATURE_ROADMAP",
        "NEXT_PUBLIC_FEATURE_EPK",
        "NEXT_PUBLIC_FEATURE_METADATA",
        "NEXT_PUBLIC_FEATURE_TASK_ATTACHMENTS",
        "NEXT_PUBLIC_FEATURE_IDENTITY_PANEL",
        "NEXT_PUBLIC_FEATURE_GENRE_PREDICTION",
        "NEXT_PUBLIC_FEATURE_NOTES",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_BING_SITE_VERIFICATION"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
