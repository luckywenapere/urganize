{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**"
      ],
      "env": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_URL",
        "PAYSTACK_SECRET_KEY",
        "TRIAL_CLAIMS_SALT",
        "PAYSTACK_PLAN_MONTHLY_CODE",
        "PAYSTACK_PLAN_8MONTHS_CODE",
        "PAYSTACK_PLAN_YEARLY_CODE",
        "PAYSTACK_PLAN_GROUP_MONTHLY_CODE",
        "PAYSTACK_PLAN_GROUP_YEARLY_CODE",
        "TRIAL_TOKENIZATION_AMOUNT_NGN",
        "ADMIN_EMAILS",
        "OLLAMA_BASE_URL",
        "OLLAMA_MODEL",
        "DATABASE_URL",
        "ADMIN_WAITLIST_TOKEN",
        "NEXT_PUBLIC_POSTHOG_TOKEN",
        "NEXT_PUBLIC_POSTHOG_HOST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    }
  }
}
