{
  "name": "urganize",
  "version": "0.38.2",
  "private": true,
  "packageManager": "pnpm@10.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/run-turbo.cjs build",
    "dev": "node scripts/run-turbo.cjs dev",
    "lint": "node scripts/run-turbo.cjs lint",
    "test": "node scripts/run-turbo.cjs test",
    "mobile:sync": "pnpm --filter @urganize/mobile exec cap sync",
    "mobile:android": "pnpm --filter @urganize/mobile exec cap sync android && pnpm --filter @urganize/mobile exec cap open android",
    "mobile:ios-ci": "pnpm --filter @urganize/mobile exec cap sync ios"
  },
  "devDependencies": {
    "next": "^16.1.1",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "protobufjs",
      "core-js",
      "unrs-resolver",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
