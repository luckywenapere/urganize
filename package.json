{
  "name": "urganize",
  "description": "Urganize is where music teams plan every release and deliver it on time.",
  "version": "1.218.0",
  "private": true,
  "packageManager": "pnpm@10.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/run-turbo.cjs build",
    "dev": "node scripts/run-turbo.cjs dev",
    "lint": "node scripts/run-turbo.cjs lint",
    "test": "node scripts/run-turbo.cjs test",
    "db:local:start": "npx -y supabase@2 start",
    "db:local:stop": "npx -y supabase@2 stop",
    "db:local:reset": "node scripts/local-db.mjs reset",
    "db:local:seed": "node scripts/local-db.mjs seed",
    "dev:local": "node scripts/dev-local.mjs",
    "mobile:start": "pnpm --filter @urganize/mobile start",
    "mobile:build:android": "pnpm --filter @urganize/mobile build:android",
    "mobile:build:ios": "pnpm --filter @urganize/mobile build:ios"
  },
  "devDependencies": {
    "next": "^16.1.1",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "protobufjs",
      "core-js",
      "unrs-resolver",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
