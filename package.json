{
  "name": "urganize",
  "version": "0.14.0",
  "private": true,
  "packageManager": "pnpm@10.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/run-turbo.cjs build",
    "dev": "node scripts/run-turbo.cjs dev",
    "lint": "node scripts/run-turbo.cjs lint",
    "test": "node scripts/run-turbo.cjs test"
  },
  "devDependencies": {
