{
  "extends": "./packages/config/typescript/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@urganize/web/*": [
        "apps/web/*"
      ],
      "@urganize/homepage/*": [
        "apps/homepage/*"
      ],
      "@urganize/ui": [
        "packages/ui/src/index.ts"
      ],
      "@urganize/ui/*": [
        "packages/ui/src/*"
      ],
      "@urganize/pricing": [
        "packages/pricing/src/index.ts"
      ],
      "@urganize/config/*": [
        "packages/config/*"
      ]
    }
  },
  "include": [
    "apps/**/*",
    "packages/**/*"
  ],
  "exclude": [
    "node_modules",
    ".turbo"
  ]
}
