generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  name            String
  phone           String?
  role            String?
  teamSize        String?
  releaseVolume   String?
  primaryNeed     String?
  metadata        Json?
  isLaunchPartner Boolean  @default(false)
  referralCode    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  // Waitlist operations (added 2026-08-04): manual outreach tracking for the
  // founder's admin/waitlist dashboard. contactStatus is a simple pipeline —
  // new | contacted | responded | converted | not_interested — driven by the
  // "Mark contacted" button and a status picker, not by any automated flow.
  contactCount    Int      @default(0)
  lastContactedAt DateTime?
  contactStatus   String   @default("new")
  adminNotes      String?
}

// Artist interview booking. One row per booked slot; slotDate is a bare
// calendar date (the time is always fixed at 6pm WAT, so it doesn't need
// its own column) and is unique — the DB itself is the source of truth for
// "is this slot taken," not a client-side check, so two artists racing for
// the same day can't both win. See app/api/interview/route.ts.
model InterviewSlot {
  id         Int      @id @default(autoincrement())
  artistName String
  phone      String
  imessage   String
  slotDate   DateTime @unique @db.Date
  createdAt  DateTime @default(now())
}
