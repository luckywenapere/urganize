# ============================================================================
# Urganize Homepage (apps/homepage) — Environment Variables
# ============================================================================
# Copy to .env.local and fill in real values.
# Lines marked [required] must be set for the app to function.
# Lines marked [optional] have fallbacks or enable non-critical features.
# ============================================================================

# --- Database (Neon PostgreSQL) ---

# [required] Neon connection string for the waitlist/signup database.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Admin Authentication ---

# ADMIN_WAITLIST_TOKEN was retired 2026-07-30: the waitlist, growth, and
# interviews admin pages moved into the product app's admin hub
# (app.urganize.app/admin, gated by the normal account login + ADMIN_EMAILS).
# The env var can be deleted from Vercel.

# --- Analytics (PostHog) ---

# [optional] PostHog project token. If unset, analytics are disabled.
NEXT_PUBLIC_POSTHOG_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [optional] PostHog API host. Defaults to https://us.i.posthog.com.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- SEO (Bing Webmaster Tools) ---

# [optional] Bing Webmaster Tools verification code (msvalidate.01 meta tag).
# Get it from bing.com/webmasters -> Add site -> HTML meta tag method.
# If unset, no verification tag is rendered.
# NEXT_PUBLIC_BING_SITE_VERIFICATION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Roadmap (public feature-voting board at /roadmap) ---

# [required if NEXT_PUBLIC_FEATURE_ROADMAP=true] Supabase project URL + anon
# key. MUST be the SAME Supabase project apps/web uses (see
# supabase/migrations/20260713_add_roadmap_feature_voting.sql) -- voting
# authenticates against that project's shared auth.users pool. Never point
# these at a new/different Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# [optional] Public feature-voting roadmap page. Defaults to 'false' (hidden;
# the /roadmap route 404s). Set to 'true' only after: (1) the migration above
# is applied to the Supabase project, (2) this app's Supabase env vars above
# are set, (3) https://urganize.app/roadmap/auth/callback is added to the
# Supabase project's Auth -> URL Configuration -> Redirect URLs.
# NEXT_PUBLIC_FEATURE_ROADMAP=false

# [optional] Public price table on /pricing. Defaults to 'false', which serves
# the book-a-demo page the founder chose in 2026-07-23 (no figures anywhere).
# Set to 'true' to show the three tiers, their prices and the monthly/annual
# toggle; every CTA stays a "book a demo" mailto in both modes.
#
# THIS MUST BE SET ON BOTH VERCEL PROJECTS. The product app reads the same flag
# to decide whether /locked sells tiers, so setting it on 'Web' alone leaves
# this site advertising nothing while the app sells tiers, and setting it here
# alone does the reverse.
#
# AND THE DEPLOY HAS TO ACTUALLY REBUILD THIS APP. The flag is read at module
# scope, so Next inlines it at BUILD time -- setting the env var with no new
# commit leaves the old bundle serving 'false' forever, because
# `npx turbo-ignore @urganize/homepage` sees a zero-file diff and correctly
# skips. A commit touching apps/homepage/** , packages/pricing or
# packages/changelog (a version bump does it) is what makes the flip land.
# NEXT_PUBLIC_FEATURE_PRICING_V2=false
