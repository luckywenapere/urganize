# Copy this file to `keystore.properties` (same directory) and fill in the real
# values after generating your upload keystore. The real file is gitignored and
# must NEVER be committed — it holds the passwords that let anyone publish a
# Play Store update as Urganize.
#
# Full procedure, including the backup step that matters more than any of this:
#   docs/mobile/android-signing.md

# Path to the keystore, relative to apps/mobile/android/ (or an absolute path).
# Keeping the .jks OUTSIDE the repo entirely is safer than relying on gitignore.
storeFile=../../../../urganize-upload-key.jks

# The password protecting the keystore file itself.
storePassword=CHANGEME

# The alias you passed to keytool -alias when generating the key.
keyAlias=urganize-upload

# The password protecting that specific key. keytool lets this match
# storePassword; if you accepted that default, use the same value here.
keyPassword=CHANGEME
