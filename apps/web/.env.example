# =====================================================================# Urganize Web App (apps/web) — Environment Variables
# ============================================================================
# Copy to .env.local and fill in real values.
# Lines marked [required] must be set for the app to function.
# Lines marked [optional] have fallbacks or enable non-critical features.
# ============================================================================

# --- Supabase ---

# [required] Supabase project URL. Exposed to the browser for client SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [required] Supabase anonymous (public) key. Exposed to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# [required] Supabase service-role key. Server-only — bypasses RLS.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# --- App URL ---

# [optional] Canonical app URL. Falls back to VERCEL_PROJECT_PRODUCTION_URL,
# then VERCEL_URL (both set automatically by Vercel).
# NEXT_PUBLIC_APP_URL=https://app.urganize.app

# --- Payments (Paystack) — recurring billing ---

# [required for payments] Paystack secret key. Used by:
#   - the webhook for HMAC signature validation
#   - /api/billing/start-checkout to initialize transactions
# Test mode uses sk_test_*, live mode sk_live_*. Swap this single value to
# move between Paystack test and live without code changes.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [required for payments] Paystack plan codes (PLN_xxx). Create the plans
# in the Paystack dashboard (one plan per currency per cycle) and paste the
# resulting codes here. The app reads these at checkout time and on
# webhook events; nothing is hardcoded. Test-mode plan codes will start
# with PLN_test_; live-mode with PLN_live_ — the prefix is informational,
# the env var values are what matters.
PAYSTACK_PLAN_MONTHLY_NGN=PLN_xxxxxxxxxx
PAYSTACK_PLAN_ANNUAL_NGN=PLN_xxxxxxxxxx
PAYSTACK_PLAN_MONTHLY_USD=PLN_xxxxxxxxxx
PAYSTACK_PLAN_ANNUAL_USD=PLN_xxxxxxxxxx
# Label tier (₦750,000/yr / $1,250/yr roster plan, added 2026-06-11).
# Create both plans in the Paystack dashboard before announcing the tier —
# until these are set, label checkout fails with "plan not configured".
PAYSTACK_PLAN_LABEL_NGN=PLN_xxxxxxxxxx
PAYSTACK_PLAN_LABEL_USD=PLN_xxxxxxxxxx

# --- AI ---

# [required for AI features] API key for the AI model gateway.
# If unset, AI features (rollout planner, status generator) are disabled.
AI_API_KEY=your-ai-gateway-api-key

# [optional] Base URL for the AI gateway. Defaults to the Zuplo gateway
# (Ollama-style protocol). Set to https://api.rodiumai.io to route via RodiumAi
# (OpenAI-style protocol; AI_API_KEY is then a RodiumAi rd_sk_… key, default
# model becomes openai/gpt-4o-mini). OpenRouter (https://openrouter.ai/api/v1)
# is also recognized (default openrouter/free). Override per feature with
# AI_PLANNER_MODEL / AI_STATUS_MODEL.
#
# Do NOT default to a RodiumAi meta/llama-* model, even though those are the
# free-tier option — confirmed 2026-08-13 against the live API that they're
# geo-blocked at the AWS Bedrock license level for this account's region
# ("Access to Meta Llama models is not allowed from unsupported countries").
# openai/gpt-4o-mini is the verified-working cheap choice instead.
# AI_API_BASE=https://api.rodiumai.io

# [optional] Model for the UrgAns release planner's tailoring call. Read at the
# route and passed per request, so it only needs to be a model the gateway
# serves. Unset means the gateway default, which may be too small to hold a
# structured-JSON contract — the planner then keeps returning the untailored
# playbook plan, which is a valid plan but not a tailored one.
# AI_PLANNER_MODEL=openai/gpt-4o-mini

# --- Admin ---

# [optional] Comma-separated list of admin email addresses.
# Required for /api/admin/* routes to function.
# ADMIN_EMAILS=admin@example.com,ops@example.com

# [optional] Neon connection string for the MARKETING site's database (the
# same DATABASE_URL the homepage app uses). Powers the admin hub's Waitlist
# and Growth dashboards (/admin/waitlist, /admin/growth), which were ported
# in from apps/homepage. When unset, only those two pages error — everything
# else in the app is unaffected.
# DATABASE_URL=postgres://user:pass@host/db

# --- Cron ---

# [required for scheduled jobs] Shared secret for /api/cron/* routes, which
# have no user session to authenticate against. Set this in Vercel's project
# env vars and Vercel automatically sends it as `Authorization: Bearer
# <value>` when triggering the cron defined in apps/web/vercel.json — no
# other wiring needed. Generate with `openssl rand -hex 32` or similar.
# CRON_SECRET=

# --- MCP access (founder-only) ---

# [optional] Bearer secret + bound account for /api/mcp, which exposes Chappi's
# tool surface to an external MCP client (Claude Code / Claude Desktop). BOTH
# must be set or the endpoint 404s — presence of the pair is the feature
# switch, so it stays dark by default. There is no per-user key mechanism: a
# caller holding MCP_ACCESS_KEY acts as MCP_USER_ID and nobody else.
#
# MCP_ACCESS_KEY — generate with `openssl rand -hex 32`. Passed by the client as
#   `Authorization: Bearer <value>`; add the server with:
#     claude mcp add --transport http urganize \
#       https://app.urganize.app/api/mcp --header "Authorization: Bearer <value>"
# MCP_USER_ID — the auth.users id every MCP call acts as (the founder's).
#
# Rotating = replacing the value here; there is no revocation UI.
# MCP_ACCESS_KEY=
# MCP_USER_ID=

# --- Web Push notifications ---

# [required for push notifications] VAPID key pair identifying this app to
# the browser push services. Generate ONCE with:
#   npx web-push generate-vapid-keys
# then set the same pair in Vercel (Web project) and never rotate casually —
# rotating invalidates every existing device subscription. The public key is
# NEXT_PUBLIC_ because the browser needs it to subscribe; the private key is
# server-only. When unset, the app runs fine with push silently disabled
# (the Settings section hides itself and sends become no-ops).
# NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=

# [optional] Contact for push-service operators (defaults to
# mailto:contact@urganize.app).
# WEB_PUSH_CONTACT=mailto:contact@urganize.app

# --- Native push notifications (FCM) ---

# [required for native push] Full Firebase service-account JSON, pasted as
# one line — see docs/mobile/push-setup.md. Server-only, deliberately not
# in turbo.json's env allowlist (same as CRON_SECRET). Reaches the
# Capacitor native shell (apps/mobile), which has no PushManager and so
# cannot use the Web Push keys above. When unset, native sends silently
# no-op (Web Push, if configured, keeps working).
# FCM_SERVICE_ACCOUNT_JSON=

# --- Analytics (PostHog) ---

# [optional] PostHog project API key (browser-side). If unset, analytics disabled.
# Set either NEXT_PUBLIC_POSTHOG_KEY or NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [optional] PostHog API host. Defaults to https://app.posthog.com.
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Analytics (Vercel) ---

# [optional] Set to "true" to enable Vercel Analytics. Disabled by default.
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=true

# --- Feature flags ---

# [optional] UrgAns release planner. When 'true', a rollout-plan release is
# created with no activities: the manager answers a short intake, reviews and
# edits the draft plan UrgAns tailors from the hand-crafted playbook, and
# approving it is what creates the tasks. Works with no model configured (the
# playbook plan becomes the draft), so this can be switched on before the
# gateway is routed. Supersedes the removed tailor-plan feature, which applied
# model output straight onto real task rows.
#
# Requires the release_plan_drafts migration
# (supabase/migrations/20260810110000_release_plan_drafts.sql).
# Do NOT enable alongside NEXT_PUBLIC_FEATURE_FIRST_WIN: that reveal celebrates
# a generated plan, and under the planner a new release has none yet.
# Defaults to 'false' (hidden; the plan API routes 404).
# NEXT_PUBLIC_FEATURE_RELEASE_PLANNER=false

# [optional] EP and album playbooks. When 'true', the EP (ep_v0.1, 16 weeks
# around a lead single at -42) and album (album_v0.1, 21 weeks around two
# staggered singles at -84 and -42) templates become selectable: the onboarding
# step-0 picker enables them, the create-release modal grows a type picker, and
# the UrgAns planner drafts EP and album plans from their own playbook instead
# of falling back to the single one.
#
# Both templates are v0.1 DRAFTS. They have not had the two design-partner
# review passes single_v0.3 went through, which is the only reason this flag
# exists — the code path is the same one single has always used.
#
# No migration needed: the release_type DB enum already accepts 'ep' and
# 'album'. Defaults to 'false' (EP/album show as "Coming soon" in onboarding,
# no type picker in the modal, planner drafts from the single playbook).
#
# LIVE IN PRODUCTION as of 2026-08-14 (v0.55.0). Note what it took: setting the
# Vercel env var was NOT enough on its own. The version-bump commit that
# accompanied the flip touched only package.json files and packages/changelog,
# which apps/web does not depend on, so `npx turbo-ignore @urganize/web` skipped
# the web build entirely — the marketing site rebuilt and the product app did
# not, leaving the env var set but never inlined. NEXT_PUBLIC_* is baked into
# the client bundle at build time, so flipping one of these flags requires a
# commit that actually touches apps/web.
#
# To check whether it is live without an account: GET /onboarding and count
# "Coming soon" in the HTML. Three means off (ep + album + music_video are all
# gated); one means on (only music_video is).
# NEXT_PUBLIC_FEATURE_EP_ALBUM_TEMPLATES=false

# [optional] AI status update generator ("Generate status update"). Defaults to
# 'false' (hidden; the API route 404s). Set to 'true' once Anthropic API key is
# configured and Zuplo gateway routes to Claude Haiku for status updates.
# NEXT_PUBLIC_FEATURE_STATUS_UPDATE=false

# [required in prod] Consolidated workspace view at /dashboard. PRODUCTION
# DEFAULT IS 'true' — the two-pane workspace (releases column + tasks panel)
# is the live experience. Leave unset locally to fall back to the LegacyDashboard
# component (kept in app/dashboard/page.tsx as a one-line revert path). Set to
# 'false' to explicitly disable in any environment (the LegacyDashboard renders
# at /dashboard). The legacy /dashboard/releases and /dashboard/tasks routes
# 308-redirect to /dashboard regardless of this flag.
# NEXT_PUBLIC_FEATURE_WORKSPACE=true

# [optional] Chappi conversational AI front door — a full-width hero at the top
# of the workspace. Phase 1 (this default) is a deterministic command bar that
# drives existing app actions and works with the AI provider OFF, so it is safe
# to enable in dev/preview immediately. The conversational agent turns on once
# CHAPPI_MODEL + CHAPPI_API_KEY are set (Phase 4). Only renders when
# NEXT_PUBLIC_FEATURE_WORKSPACE is also on. Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_CHAPPI=false

# [optional] Release content calendar (URG-157). When 'true', each release gains
# a "Content" section (calendar list) and a /dashboard/releases/[id]/calendar
# page for planning social posts per platform account. Planning only, no
# posting. Requires the content_calendar migration to be applied to the
# database first; with the flag off, all content-calendar API routes 404.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_CONTENT_CALENDAR=false

# [optional] "First win" moment (URG-107). When 'true', a new user's FIRST
# release creation triggers a celebratory reveal of the auto-generated rollout
# plan + a (skippable) teammate invite, instead of navigating straight to the
# release. Purely additive UX; safe to enable. Defaults to 'false'.
# NEXT_PUBLIC_FEATURE_FIRST_WIN=false

# [optional] Release file/asset storage (URG-182). Gates the Asset section on
# the release detail page, the standalone /dashboard/releases/[id]/files page,
# the workspace "Files" link, and the assets API routes (404 when off). This
# turns the feature OFF, it does not delete anything: existing rows in the
# `assets` table and objects in the `release-assets` bucket are untouched, and
# flipping this back to 'true' restores access to them. Defaults to 'false'
# (hidden) as of URG-182 — was previously always on with no flag.
# NEXT_PUBLIC_FEATURE_FILES=false

# [optional] Mobile bottom navigation. When 'true', below lg the topbar's nav
# icons (Catalog/UrgAns, Notes) and the "New release" CTA move into a fixed
# bottom tab bar (Home / UrgAns / New release / Notes / You), and the
# ChappiDock floating launcher retires on that same range (the bar's UrgAns
# tab replaces it; its WhatsApp founder link moves to a footer row on the
# /dashboard/urgans page). Purely additive chrome; no migration, no data
# change. Defaults to 'false' (hidden; topbar and dock render exactly as
# before).
# NEXT_PUBLIC_FEATURE_MOBILE_NAV=false

# [optional] EPK generator (URG-196). When 'true', each release gains a
# "Press kit" section that generates a public, shareable EPK link at
# /epk/[token] — auto-assembled from release data (artist, title, date,
# description, metadata, cover art, promo images) on every request, so it
# stays in sync with the release. Image assets only; audio/documents never
# surface publicly. Requires the release_epks migration to be applied first;
# with the flag off, the EPK API routes 404 and /epk/[token] 404s.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_EPK=false

# [optional] Fan email capture (2026-08-14). Conscious v1 scope expansion
# (see CLAUDE.md). When 'true', each release gains a "Fan capture" scene: the
# owner authors one public page (graphic, headline, incentive, destination
# link) at /capture/[token], a fan gives an email and the link is revealed on
# the same screen, and the collected emails come back in-app for export. The
# hand-crafted conversion playbook in lib/capture-playbook grades the page as
# it is written. Storage and display only — nothing sends email, and the
# destination is a plain URL the manager types (no DSP, no pre-save API).
# Requires the release_capture_pages migration to be applied first; with the
# flag off, the capture API routes 404 and /capture/[token] 404s.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_CAPTURE=false

# [optional] Team logins (founder request, 2026-08-16). When 'true', two
# things switch on: (1) creating a release opens a compulsory "get your team
# in" step that auto-generates a sign-in link for that release, and (2)
# Settings -> Team gains a "Team logins" section where a manager generates as
# many links as they need, copies each to WhatsApp or email, and revokes any
# of them. A login is a LINK, never a password — whoever opens it chooses
# their own password on /invite/accept, so nothing shareable is ever a
# readable credential.
# Builds on the invite-link machinery that has shipped since 2026-07-23; the
# mint endpoint (POST /api/workspace/invite-link) stays live either way,
# because Settings -> Teammates already calls it. This flag gates the LIST and
# REVOKE endpoints, the new section, and the post-create step.
# Requires the workspace_invite_links team-logins migration
# (20260816100000) for labels, release provenance and the revoke audit
# column; without it links still mint, they just lose that context.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_TEAM_LOGINS=false

# [optional] Release metadata hub + collaborator credit capture (URG-108).
# Third conscious v1 scope expansion (see CLAUDE.md). When 'true', each
# release gains a "Metadata" section: an editable distribution-metadata form
# (ISRC, UPC, genre, language, explicit, label, (P)/(C) lines) plus a
# shareable, no-login link at /credits/[token] where collaborators submit
# publishing/split-sheet credits (legal name, roles, songwriter/master
# splits, PRO/IPI, publisher, socials). Submissions are capture + display
# only — no automation, no signing. Requires the release_credits_capture
# migration to be applied first; with the flag off, the credits API routes
# 404 and /credits/[token] 404s.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_METADATA=false

# [optional] Task attachments (URG-203). Gates the "Attachments" section in
# the task detail pop-up and the two task-attachment API routes (404 when
# off). Distinct from NEXT_PUBLIC_FEATURE_FILES, which is release-level file
# storage. Turns the feature OFF, it does not delete anything: existing rows
# in `task_attachments` and objects in the `task-attachments` bucket are
# untouched, and flipping this back to 'true' restores access to them.
# Defaults to 'false' (hidden) as of URG-203 — was previously always on with
# no flag.
# NEXT_PUBLIC_FEATURE_TASK_ATTACHMENTS=false

# [optional] Workspace identity card (URG-214). When 'true', a compact
# LinkedIn-company-page-style card (logo, workspace/label name, artist name,
# teammate + active-release counts) renders in a persistent left column
# across the dashboard, UrgAns, Settings, and per-release scene pages.
# Display-only — edits happen in Settings. Only meaningful when
# NEXT_PUBLIC_FEATURE_WORKSPACE is also 'true'; gates the identity panel, the
# Settings "Workspace identity" section, and the /api/workspace/identity +
# /api/workspace (PATCH) routes (404 when off).
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_IDENTITY_PANEL=false

# [optional] Genre prediction from audio. When 'true', the Metadata scene's
# Genre field gains a "Predict from audio" action: the user picks a local
# audio file (4 MiB max), it is proxied server-side to an external genre
# classifier, and the predicted genre prefills the field for review before
# saving. The audio is never stored and nothing is written until the user
# saves. Only meaningful when NEXT_PUBLIC_FEATURE_METADATA is also 'true';
# requires GENRE_PREDICTION_URL. Gates the control and the
# /api/releases/[releaseId]/metadata/predict-genre route (404 when off).
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_GENRE_PREDICTION=false

# [optional] Notes: private, owner-scoped quick capture at /dashboard/notes,
# with an optional link to a release. Gates the topbar icon, the workspace
# identity panel's nav entry, the scoped-release "Notes" link in the tasks
# panel, the page itself (bounces to /dashboard when off), and all four
# /api/notes routes (404 when off). Requires the notes migration
# (supabase/migrations/20260808120000_notes.sql) to be applied first.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_NOTES=false

# [optional] Task outcomes ("Done. How did it go?"). When 'true', marking a
# task done opens an UrgAns bottom sheet asking how it went: three outcome
# chips, an optional note, and at most one AI follow-up question when a note
# was written. Outcomes land in the task_outcomes table and show read-only on
# the task detail pop-up. Per-user "Ask me after tasks" toggle in Settings
# (on by default) disables the sheet. Works with AI off: summaries fall back
# to templates and no follow-up is asked. The AI call uses AI_OUTCOME_MODEL,
# falling back to AI_STATUS_MODEL, then the gateway default, with a 3 second
# budget that fails silently. Requires the task_outcomes migration
# (supabase/migrations/20260809120000_task_outcomes.sql) to be applied first;
# with the flag off, the /api/tasks/[id]/outcome route 404s.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_TASK_OUTCOMES=false

# [optional] Playlist pitching. When 'true', teams get a "Pitch" scene on a
# scoped release for browsing curator playlists and sending a song, and invited
# curators get their own surface at /curator (inbox, playlists, profile) with no
# access to any team data. Curator access is invite-only: an admin mints
# single-use links at /admin/curator-invites. Gates the workspace pill, the
# /curator pages (which bounce when off), and every /api/curator,
# /api/pitching and /api/admin/curator-invites route (404 when off). Requires
# the pitching migration
# (supabase/migrations/20260810100000_playlist_pitching.sql) to be applied
# first, since it also widens the profiles.role check to admit 'curator'.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_PITCHING=false

# [optional] Native push notifications. When 'true', the Capacitor native
# shell (apps/mobile) registers for FCM/APNs push and Settings' push section
# renders the native variant instead of hiding (a native webview has no
# PushManager, so the Web Push variant never applies there). Requires
# FCM_SERVICE_ACCOUNT_JSON to be set for sends to actually go out — see
# docs/mobile/push-setup.md — and the device_push_tokens migration
# (supabase/migrations/20260810130000_device_push_tokens.sql) to be applied
# first. Release reminders, weekly motivational nudges, and deadline-tier
# copy are editable at /admin/notifications regardless of this flag; this
# flag only gates the NATIVE transport and its client UI — Web Push (browser
# subscriptions) is unaffected either way.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_NATIVE_PUSH=false

# --- Row-level-security tests (development only) ---

# [optional, dev only] Points lib/pitching-rls.integration.test.ts at a real
# development Supabase project so it can prove the pitching isolation rules with
# actual PostgREST calls as signed-in users. With these unset the whole suite
# skips, so `pnpm test` stays offline and green. NEVER point these at
# production: the tests sign in as real accounts and attempt writes.
# Full setup steps are in that test file's header.
# RLS_TEST_SUPABASE_URL=
# RLS_TEST_ANON_KEY=
# RLS_TEST_TEAM_A_EMAIL=
# RLS_TEST_TEAM_A_PASSWORD=
# RLS_TEST_TEAM_B_EMAIL=
# RLS_TEST_TEAM_B_PASSWORD=
# RLS_TEST_CURATOR_1_EMAIL=
# RLS_TEST_CURATOR_1_PASSWORD=
# RLS_TEST_CURATOR_2_EMAIL=
# RLS_TEST_CURATOR_2_PASSWORD=
# RLS_TEST_PITCH_ID=
# RLS_TEST_CURATOR_1_USER_ID=

# [optional] Release recap card. When 'true', a scoped release whose date has
# passed (or whose every task is done) gets a "Get your release recap" action
# that builds a shareable poster: two PNGs (1080x1920 story and 1080x1080
# square) rendered server-side from the release's own numbers, stored in the
# release-assets bucket and shared through the native share sheet on mobile or
# downloaded on the web. One optional input, a highlight, is entered by hand.
# Playlist pitch counts appear on the card only when the pitching feature's
# table is present, and are omitted silently otherwise. Requires the recap
# migrations (supabase/migrations/20260810090000_release_recaps.sql and
# 20260810120000_release_recaps_drop_first_week_streams.sql) to be applied
# first; with the flag off, the /api/releases/[releaseId]/recap route 404s
# and no action is shown.
# Defaults to 'false' (hidden).
# NEXT_PUBLIC_FEATURE_RELEASE_RECAP=false

# [required for genre prediction] Full endpoint URL of the external genre
# model's predict endpoint (a FastAPI service on an AWS Lambda function URL,
# owned by a collaborating developer). Server-only on purpose: the upstream
# has no authentication today, so the URL must never reach a client bundle.
# When unset, the predict-genre route returns 503.
# GENRE_PREDICTION_URL=https://<function-id>.lambda-url.us-east-1.on.aws/predict

# [optional] Shared secret forwarded to the genre model as an x-api-key
# header. Pre-wired for when the model's owner adds authentication; ignored
# upstream until then, so it is harmless to set early.
# GENRE_PREDICTION_API_KEY=

# [optional] Chappi conversational backend (Phase 2+). CHAPPI_MODEL is a
# tool-capable catalogue id on the RodiumAi gateway — openai/gpt-4o-mini is
# verified working (real tool_calls, correct arguments, tested 2026-08-13).
# Do NOT use a meta/llama-* model here: RodiumAi's free tier is all Meta/AWS
# Bedrock, and Bedrock's Meta license blocks unsupported countries/regions —
# confirmed live against this account, not a code bug. CHAPPI_API_KEY is the
# RodiumAi key (rd_sk_…), kept separate from AI_API_KEY so the two transports
# have independent credentials. CHAPPI_API_BASE overrides the gateway base URL
# (defaults to https://api.rodiumai.io/v1); the endpoint must speak OpenAI
# chat completions with tools/tool_calls.
# CHAPPI_MODEL=openai/gpt-4o-mini
# CHAPPI_API_KEY=
# CHAPPI_API_BASE=https://api.rodiumai.io/v1

# ============================================================================
# Removed in the recurring billing migration (2026-06-05)
# ============================================================================
# The following env vars are no longer read by the app:
#
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY  — was used by client-side <PaystackButton>;
#                                    the inline checkout flow has been replaced
#                                    by server-initiated /api/billing/start-checkout
#                                    which uses PAYSTACK_SECRET_KEY only.
# PAYSTACK_PLAN_MONTHLY_CODE       — renamed to PAYSTACK_PLAN_MONTHLY_NGN
# PAYSTACK_PLAN_YEARLY_CODE        — renamed to PAYSTACK_PLAN_ANNUAL_NGN
# PAYSTACK_PLAN_GROUP_*            — group billing dropped from v1 surface
# PAYSTACK_PLAN_8MONTHS_CODE       — legacy plan, removed
# TRIAL_TOKENIZATION_AMOUNT_NGN    — card-on-file trial removed
# TRIAL_CLAIMS_SALT                — card-on-file trial removed
# SUPABASE_URL                     — replaced by NEXT_PUBLIC_SUPABASE_URL
