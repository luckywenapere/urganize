# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Urganize

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
NEXT_PUBLIC_POSTHOG_KEY=
# Legacy alias also supported:
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Paystack plan codes (used for auto-renewal after 30-day trial)
PAYSTACK_PLAN_MONTHLY_CODE=
PAYSTACK_PLAN_8MONTHS_CODE=
PAYSTACK_PLAN_YEARLY_CODE=
PAYSTACK_PLAN_GROUP_MONTHLY_CODE=
PAYSTACK_PLAN_GROUP_YEARLY_CODE=

# Trial security and card authorization amount (NGN)
TRIAL_CLAIMS_SALT=
TRIAL_TOKENIZATION_AMOUNT_NGN=100

# AI Generation (OpenRouter)
OPENROUTER_API_KEY=
# Primary model, or comma-separated fallback list
OPENROUTER_MODEL=

# AI Gateway (Zuplo)
AI_API_BASE=https://urganize-main-34fd8f6.d2.zuplo.dev
AI_API_KEY=

# Support chat (Tawk.to). Both required for the widget to mount.
# Find these at: Admin → Channels → Chat Widget → Direct Chat Link
# Format: https://tawk.to/chat/<PROPERTY_ID>/<WIDGET_ID>
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
